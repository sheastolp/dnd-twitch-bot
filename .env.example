# GuildScribe settings. On the Yoga laptop these live in
# /etc/tavernworks/guildscribe.env (copy the values from Val Town's
# environment variables page before you leave it). Optional tuning variables
# are listed in README.md.

# Twitch app + bot account
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
EVENTSUB_SECRET=

# Operator routes (/admin/...), 32+ random characters
ADMIN_API_SECRET=

PUBLIC_BASE_URL=https://guildscribe.tavernworks.dev
PORT=8801
DB_PATH=./data/guildscribe.sqlite

# AI replies for !haggle, NPCs and @GuildScribeBot mentions. Either OpenAI:
OPENAI_API_KEY=
# ...or Ollama on the Local AI laptop (no key; use a model you've pulled):
# OPENAI_BASE_URL=http://<ai-laptop>:11434/v1
# OPENAI_MODEL=llama3.2
