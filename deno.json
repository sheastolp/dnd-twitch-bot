{
  "lock": false,
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write server.ts",
    "check": "deno check server.ts",
    "import-db": "deno run --allow-net --allow-env --allow-read --allow-write tools/import_db.ts"
  },
  "compilerOptions": {
    "noImplicitAny": false,
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "node_modules_dir": false
}
